#!/usr/bin/env bash
set -euo pipefail

project_dir="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
python_bin="$project_dir/.venv-linux/bin/python"

if [[ ! -x "$python_bin" ]]; then
    echo "error: virtual environment not found: $python_bin" >&2
    echo "create it with: python3 -m venv $project_dir/.venv-linux" >&2
    exit 127
fi

exec "$python_bin" "$project_dir/tests/hardware_test.py" "$@"
